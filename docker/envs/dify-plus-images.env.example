# Optional Dify-Plus image and worker overrides.
# The fork Compose does not load this file automatically. Copy selected values
# into docker/.env, or pass this file as an additional --env-file after .env.
# Keep all four images on the same release; production may pin index digests.
DIFY_PLUS_API_IMAGE=ghcr.io/yfgaia/dify-plus-api:1.17.1-plus.2
DIFY_PLUS_WEB_IMAGE=ghcr.io/yfgaia/dify-plus-web:1.17.1-plus.2
DIFY_PLUS_AGENT_IMAGE=ghcr.io/yfgaia/dify-plus-agent-backend:1.17.1-plus.2
DIFY_PLUS_LOCAL_SANDBOX_IMAGE=ghcr.io/yfgaia/dify-plus-agent-local-sandbox:1.17.1-plus.2

# Separate supplier and capability from the four source-built release images.
# Enable the full-sandbox Compose profile only when using authorized full code execution.
DIFY_PLUS_FULL_SANDBOX_IMAGE=ccr.ccs.tencentyun.com/yfgaia/dify-plus-sandbox-full:1.2.2
FULL_CODE_EXECUTION_ENDPOINT=http://sandbox-full:8194

# These queue overrides are isolated from each other and from the main worker.
DIFY_PLUS_EXTEND_CELERY_QUEUES=extend_high,extend_low
DIFY_PLUS_DATASET_CELERY_QUEUES=dataset,priority_dataset
