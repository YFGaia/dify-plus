# ------------------------------------------------------------------
# Essential defaults for Docker Compose deployments.
# Only include variables required for services to start.
# Do not add optional variables to this file.
#
# Copy this file to .env and configure the required credentials before startup.
# Dify-Plus uses docker-compose.dify-plus.yaml. Run its explicit migration
# profile with business services stopped, verify both migration chains, then
# start business services; see the migration service comments for the command.
#
# Optional and provider-specific variables live under docker/envs/.
# Upstream docker-compose.yaml loads optional files copied beside their samples
# without the .example suffix; docker/.env overrides those service env files.
# The fork Compose uses explicit environment mappings, not service env_file.
# For it, copy needed mapped values into docker/.env; unmapped settings require
# an explicit service environment override. Copying a service sample alone
# does not configure the fork deployment.
# ------------------------------------------------------------------

# Default database, vector store and dedicated WebSocket service.
# To stop the dedicated WebSocket service, remove `collaboration` and set
# NGINX_SOCKET_IO_UPSTREAM=api:5001 in docker/.env.
COMPOSE_PROFILES=${VECTOR_STORE:-weaviate},${DB_TYPE:-postgresql},collaboration

# Required before startup, including when Agent v2 is disabled: the configured
# Agent Stub URL requires this secret. It derives the JWE encryption key for
# Agent Stub bearer tokens. Set a separate strong random value in docker/.env.
# Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
DIFY_AGENT_SERVER_SECRET_KEY=
