# Please do not directly edit this file. Instead, modify the .env variables related to NGINX configuration.

server {
    listen ${NGINX_PORT};
    server_name ${NGINX_SERVER_NAME};

    # Resolve Docker service names at request time so upstream containers can be
    # recreated without forcing an nginx restart to refresh cached IPs.
    resolver 127.0.0.11 ipv6=off valid=10s;
    set $api_upstream http://api:5001;
    set $web_upstream http://web:3000;
    set $plugin_daemon_upstream http://plugin_daemon:5002;

    location /console/api {
      proxy_pass $api_upstream;
      include proxy.conf;
    }

    location /api {
      proxy_pass $api_upstream;
      include proxy.conf;
    }

    location /socket.io/ {
      resolver 127.0.0.11 valid=30s ipv6=off;
      set $socket_io_upstream ${NGINX_SOCKET_IO_UPSTREAM};
      proxy_pass http://$socket_io_upstream;
      include proxy.conf;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_cache_bypass $http_upgrade;
    }

    location /v1 {
      proxy_pass $api_upstream;
      include proxy.conf;
    }

    location /openapi {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /files {
      proxy_pass $api_upstream;
      include proxy.conf;
    }

    location /explore {
      proxy_pass $web_upstream;
      include proxy.conf;
    }

    location /e/ {
      proxy_pass $plugin_daemon_upstream;
      proxy_set_header Dify-Hook-Url $scheme://$host$request_uri;
      include proxy.conf;
    }

    location / {
      proxy_pass $web_upstream;
      include proxy.conf;
    }

    location /mcp {
      proxy_pass $api_upstream;
      include proxy.conf;
    }

    location /triggers {
      proxy_pass $api_upstream;
      include proxy.conf;
    }
    
    # placeholder for acme challenge location
    ${ACME_CHALLENGE_LOCATION}

    # placeholder for https config defined in https.conf.template
    ${HTTPS_CONFIG}
}
