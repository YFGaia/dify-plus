const now=cp.execFileSync('git',['ls-files','--others','--exclude-standard','-z']).toString().split('\0').filter(Boolean);
const added=now.filter(f=>!original.includes(f));const missing=original.filter(f=>!now.includes(f));
assert.equal(missing.length,0);for(const f of added)assert(evidence.commit_allowlist.includes(f),'unowned untracked addition '+f);
const tasks=fs.readFileSync(b+'tasks.md','utf8');assert(tasks.includes('- [x] 7.1 [M01]'));assert(tasks.includes('- [ ] 7.2 [M01]'));assert(tasks.includes('- [x] 7.3 [M01]'));assert(tasks.includes('- [ ] 7.4 [M01]'));assert(!tasks.split('\n')[2].includes('ready 待'));
const output={result:'passed',graph_node_count:after.nodes.length,propagated_blocked:ids,M00_ancestry_and_conflict_origins:true,other_node_states_and_all_authorizations_unchanged:true,locks_unchanged:true,owned_tracked_paths_only:true,visible_untracked:{before:original.length,missing:missing,added_M01_only:added,original_path_set_sha256:hash(fs.readFileSync(dir+'/untracked-before')),ignored_venv_exception:'api/.venv was recreated by uv; see explicit side-effect evidence.'}};
